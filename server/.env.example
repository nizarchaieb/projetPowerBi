# Configuration du serveur VentesDB — copier vers .env et adapter.
PORT=5000

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ventesdb

# Générer avec un gestionnaire de secrets (au moins 32 caractères aléatoires).
JWT_SECRET=

# Créer ou réinitialiser explicitement le premier compte administrateur.
ADMIN_NAME=Administrateur
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Compte lecteur facultatif pour la démonstration hébergée.
DEMO_NAME=Lecteur de démonstration
DEMO_EMAIL=
DEMO_PASSWORD=
